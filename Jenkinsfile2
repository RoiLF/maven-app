pipeline {
    agent any

    tools {
        maven 'jenkins-maven'
    }

    stages {
        stage("Build JAR") {
            steps { 
                echo 'Building the Java app...'
                sh 'mvn clean package'
            }
        }

        stage("Build & Push Image") {
            // Declaramos las variables dinámicas solo para esta etapa
            environment {
                DOCKER_REPO = 'RoiLF/demo-app'
                // Combina tu versión base con el número de ejecución de Jenkins
                IMAGE_TAG = "jma-2.0.${env.BUILD_NUMBER}" 
            }
            steps { 
                echo "Building and pushing the Docker image: ${DOCKER_REPO}:${IMAGE_TAG}..."
                
                withCredentials([usernamePassword(credentialsId: 'agarciaf-dockerhub', passwordVariable: 'PASS', usernameVariable: 'USER')]) {
                    
                    // Construimos la imagen con el tag dinámico y como 'latest'
                    sh "docker build -t ${DOCKER_REPO}:${IMAGE_TAG} -t ${DOCKER_REPO}:latest ."
                    
                    // Login seguro (comillas simples para que no se resuelva en Groovy)
                    sh 'echo $PASS | docker login -u $USER --password-stdin'
                    
                    // Subimos ambas etiquetas
                    sh "docker push ${DOCKER_REPO}:${IMAGE_TAG}"
                    sh "docker push ${DOCKER_REPO}:latest"
                }
            }
        }

        stage("Deploy") {
            steps { 
                echo 'Deploying the app...'
                // Aquí vendrá la lógica de tu despliegue
            }
        }
    }
}
